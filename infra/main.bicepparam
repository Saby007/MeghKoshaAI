using './main.bicep'

param environmentName = readEnvironmentVariable('AZURE_ENV_NAME')
param location = readEnvironmentVariable('AZURE_LOCATION', 'centralindia')
param foundryLocation = readEnvironmentVariable('FOUNDRY_LOCATION', 'eastus2')
param profile = readEnvironmentVariable('APP_PROFILE', 'core')
param assessmentMode = readEnvironmentVariable('APP_ASSESSMENT_MODE', 'postgres')
param postgresSkuName = readEnvironmentVariable('APP_POSTGRES_SKU', 'Standard_D2ds_v5')
param postgresSkuTier = readEnvironmentVariable('APP_POSTGRES_TIER', 'GeneralPurpose')
param postgresVersion = readEnvironmentVariable('APP_POSTGRES_VERSION', '16')
param postgresStorageGB = int(readEnvironmentVariable('APP_POSTGRES_STORAGE_GB', '128'))
param assessmentWorkerCpu = readEnvironmentVariable('APP_ASSESSMENT_WORKER_CPU', '4.0')
param assessmentWorkerReplicas = int(readEnvironmentVariable('APP_ASSESSMENT_WORKER_REPLICAS', '1'))
param assessmentQueueCapacity = int(readEnvironmentVariable('APP_ASSESSMENT_QUEUE_CAPACITY', '50'))
param assessmentPoolSize = int(readEnvironmentVariable('APP_ASSESSMENT_POOL_SIZE', '5'))
param assessmentImage = readEnvironmentVariable('SERVICE_ASSESSMENT_IMAGE_NAME', '')
param assessmentFoundationOnly = bool(readEnvironmentVariable('APP_ASSESSMENT_FOUNDATION_ONLY', 'false'))
param assessmentLimits = json(readEnvironmentVariable('APP_ASSESSMENT_LIMITS', '{}'))
param resourceGroupName = readEnvironmentVariable('AZURE_RESOURCE_GROUP', '')
param vnetAddressPrefix = readEnvironmentVariable('APP_VNET_PREFIX', '10.42.0.0/23')
param containerSubnetPrefix = readEnvironmentVariable('APP_CONTAINER_SUBNET_PREFIX', '10.42.0.0/24')
param privateEndpointSubnetPrefix = readEnvironmentVariable('APP_PRIVATE_ENDPOINT_SUBNET_PREFIX', '10.42.1.0/27')
param apiImage = readEnvironmentVariable('SERVICE_API_IMAGE_NAME', '')
param webImage = readEnvironmentVariable('SERVICE_WEB_IMAGE_NAME', '')
param apiClientId = readEnvironmentVariable('MEGHKOSHA_API_CLIENT_ID', '')
param webClientId = readEnvironmentVariable('MEGHKOSHA_WEB_CLIENT_ID', '')
param minimumReplicas = int(readEnvironmentVariable('APP_MIN_REPLICAS', '1'))
param logRetentionDays = int(readEnvironmentVariable('APP_LOG_RETENTION_DAYS', '30'))
param storageSku = readEnvironmentVariable('APP_STORAGE_SKU', 'Standard_LRS')
param allowNativeExportTrustedServices = bool(readEnvironmentVariable('APP_EXPORT_TRUSTED_SERVICES', 'false'))
param privateRegistry = bool(readEnvironmentVariable('APP_PRIVATE_REGISTRY', readEnvironmentVariable('APP_ASSESSMENT_MODE', 'postgres') == 'postgres' ? 'true' : 'false'))
param registryBuildMode = readEnvironmentVariable('APP_REGISTRY_BUILD_MODE', readEnvironmentVariable('APP_ASSESSMENT_MODE', 'postgres') == 'postgres' ? 'private-runner' : 'managed-pool')
param blobDataProtection = bool(readEnvironmentVariable('APP_BLOB_DATA_PROTECTION', 'false'))
param blobRetentionDays = int(readEnvironmentVariable('APP_BLOB_RETENTION_DAYS', '7'))
param dailyExportRetentionDays = int(readEnvironmentVariable('APP_DAILY_EXPORT_RETENTION_DAYS', '60'))
param closedMonthRetentionDays = int(readEnvironmentVariable('APP_CLOSED_MONTH_RETENTION_DAYS', '214'))
param exportParallelMonths = int(readEnvironmentVariable('APP_EXPORT_PARALLEL_MONTHS', '1'))
param enableProcessor = bool(readEnvironmentVariable('APP_ENABLE_PROCESSOR', 'false'))
param processorImage = readEnvironmentVariable('SERVICE_PROCESSOR_IMAGE_NAME', '')
param processorSchedule = readEnvironmentVariable('APP_PROCESSOR_CRON', '*/5 * * * *')
param foundryProjectName = readEnvironmentVariable('APP_FOUNDRY_PROJECT_NAME', 'cost-agent-project')
param modelDeployments = json(readEnvironmentVariable('APP_MODEL_DEPLOYMENTS', '[]'))
param enableAiRuntime = bool(readEnvironmentVariable('APP_ENABLE_AI_RUNTIME', 'false'))
param enableChatRuntime = bool(readEnvironmentVariable('APP_ENABLE_CHAT_RUNTIME', 'false'))
param restoreAiAccount = bool(readEnvironmentVariable('APP_RESTORE_AI_ACCOUNT', 'false'))
param reuseAiAccount = bool(readEnvironmentVariable('APP_REUSE_AI_ACCOUNT', 'false'))
param agentName = readEnvironmentVariable('AGENT_NAME', 'cost-agent')
param modelRouterDeploymentName = readEnvironmentVariable('MODEL_ROUTER_DEPLOYMENT_NAME', '')
