MEGHKOSHA_AI_ENABLED=false
FOUNDRY_CHAT_ENABLED=false
AI_PROJECT_ENDPOINT=https://<your-foundry-resource>.services.ai.azure.com/api/projects/<your-project>
AI_SERVICES_ENDPOINT=https://<your-foundry-resource>.cognitiveservices.azure.com/
AGENT_NAME=cost-agent
MODEL_ROUTER_DEPLOYMENT_NAME=model-router
AZURE_TENANT_ID=<single-tenant-directory-id>
MEGHKOSHA_API_CLIENT_ID=<api-application-client-id>
MEGHKOSHA_WEB_CLIENT_ID=<secretless-spa-client-id>
COST_EXPORT_NAME=focus-closed-month-local-dev
MEGHKOSHA_ACTION_WRITES_PAUSED=true
APP_SCHEDULER_ENABLED=false
AZURE_CLIENT_ID=<runtime-user-assigned-managed-identity-client-id>
COST_EXPORT_STORAGE_URL=https://<approved-adls-account>.blob.core.windows.net
COST_EXPORT_STORAGE_RESOURCE_ID=/subscriptions/<hosting-subscription>/resourceGroups/<resource-group>/providers/Microsoft.Storage/storageAccounts/<approved-adls-account>
CONTROL_STATE_CONTAINER=control-state
COST_EXPORT_CONTAINER=cost-exports
REPORT_SNAPSHOT_CONTAINER=report-snapshots
# Existing local workflows stay explicit; new Bicep configurations default to postgres.
ASSESSMENT_MODE=blob
# PostgreSQL mode requires private networking and the separately verified MI bootstrap.
ASSESSMENT_DB_HOST=<private-server>.postgres.database.azure.com
ASSESSMENT_DB_NAME=meghkosha
ASSESSMENT_DB_USER=meghkosha_api
ASSESSMENT_DB_POOL_SIZE=5
